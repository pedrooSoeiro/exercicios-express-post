{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "projeto-1-mensagem/src/**/*",
    "projeto-2-soma/src/**/*",
    "projeto-3-login/src/**/*"
  ]
}